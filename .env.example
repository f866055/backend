# ========================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Servidor Backend NestJS - GaragePro
# ========================================================

# Entorno: development | production
NODE_ENV=production
PORT=3000

# Base de datos (PostgreSQL en Railway o local)
# En Railway: conecta tu servicio Postgres y asigna la variable DATABASE_URL
DATABASE_URL=postgresql://usuario:password@host:port/database

# Configuración alternativa si no usas DATABASE_URL:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=db_garaje

# SSL de base de datos (true | false)
# Si te conectas a Railway Postgres desde el exterior, usa true
DB_SSL=false

# Sincronización automática de esquemas TypeORM (true | false)
# En Railway puedes poner true para crear tablas automáticamente en una base nueva
DB_SYNC=true

# CORS y Frontend
# Define los dominios autorizados para consultar el backend
CORS_ORIGINS=http://localhost:3001,https://tu-frontend.up.railway.app
FRONTEND_URL=https://tu-frontend.up.railway.app

# JWT (Autenticación con cookies HttpOnly)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui
JWT_EXPIRES_IN=1d

# Plate Recognition (Perú) - https://platerecognizer.com/ (Opcional)
PLATE_RECOGNIZER_TOKEN=

# Cloudinary (Subida de fotos de vehículos y perfiles) (Opcional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
